# Esimerkkikonfiguraatio. Kopioi .env-nimiseksi ja muokkaa.
# Kaikki asetukset voi antaa myös ympäristömuuttujina tai config.yaml:ssa.
# Prioriteetti: ympäristömuuttuja > .env > config.yaml > koodin oletus.

# --- Mallin valinta -------------------------------------------------------
# Oletus on "auto": palvelin tunnistaa VRAM:n ja järjestelmämuistin, päättelee
# tierin ja valitsee sen mukaan sekä mallin että lataustavan. Valinta ja sen
# perustelu logitetaan käynnistyksessä. Sama konfiguraatio toimii siis eri
# laitteistoilla ilman koodimuutosta.
# VIDEO_SERVER_BACKEND=auto

# Kehitys ilman GPU:ta ja ilman painoja. Koko rajapinta toimii, ulostulona
# synteettinen mp4. Tällä ajetaan testit.
# VIDEO_SERVER_BACKEND=mock

# Eksplisiittinen malli ohittaa automaattivalinnan:
# VIDEO_SERVER_BACKEND=wan2.2-ti2v-5b     # 5B, T2V + I2V, 720p @ 24 fps
# VIDEO_SERVER_BACKEND=wan2.2-t2v-a14b    # MoE 14B, vain teksti -> video
# VIDEO_SERVER_BACKEND=wan2.2-i2v-a14b    # MoE 14B, vaatii aloituskuvan

# --- Mitä tier tarkoittaa -------------------------------------------------
# low          12-20 GB VRAM   TI2V-5B 4-bit-kvantisoituna (vaatii quantized-extran)
# mid          20-30 GB VRAM   TI2V-5B bf16          <- RTX 3090 osuu tähän
# high         30 GB+  VRAM    A14B bf16
# a14b-offload 24 GB + 60 GB RAM  A14B CPU-offloadilla, hidas
#
# Tierin voi pakottaa, jos haluaa tietoisesti kevyemmän profiilin:
# VIDEO_SERVER_TIER=auto

# --- Laitteisto -----------------------------------------------------------
VIDEO_SERVER_DEVICE=cuda:0
VIDEO_SERVER_DTYPE=bfloat16
# Moni-GPU: valitse kortti (ei rinnakkaisajoa, vaan kumpaa käytetään).
# VIDEO_SERVER_DEVICE=cuda:1

# --- Muistinkäyttö --------------------------------------------------------
# Tiilitetty VAE-dekoodaus. Dekoodaus on ajon suurin muistipiikki: ilman tätä
# 24 GB:n kortti kaatuu 720p-videolla OOM:iin vasta kun denoising on jo valmis.
# VIDEO_SERVER_VAE_TILING=true
#
# Pakota CPU-offload päälle tai pois. Tyhjänä tier ja VRAM-tarkistus päättävät.
# Aseta true, jos kortilla on muuta käyttöä samaan aikaan.
# VIDEO_SERVER_CPU_OFFLOAD=true

# --- Painojen lataus ------------------------------------------------------
# Oletuksena palvelin EI lataa painoja itse vaan kertoo puuttuvista painoista
# ja komennon jolla ne haetaan:
#   uv run python scripts/download_model.py wan2.2-ti2v-5b
# Huom: TI2V-5B vie ~32 GB levyä ja ~23 GB VRAM:ia ajossa.
# VIDEO_SERVER_ALLOW_DOWNLOAD=false

# --- Ulostulot ja siivous -------------------------------------------------
# VIDEO_SERVER_OUTPUTS_DIR=video_server/outputs
# Molemmat säännöt ovat voimassa yhtä aikaa; tyhjä arvo poistaa säännön.
# VIDEO_SERVER_RETENTION_MAX_AGE_DAYS=14
# VIDEO_SERVER_RETENTION_MAX_TOTAL_GB=20

# --- Jono ja pyynnöt ------------------------------------------------------
# Täysi jono vastaa 429, liian suuri runko 413.
# VIDEO_SERVER_MAX_QUEUE_SIZE=8
# VIDEO_SERVER_MAX_REQUEST_BYTES=20971520

# --- Profiilin oletusten ohitus -------------------------------------------
# Tyhjänä käytetään mallin omia arvoja, jotka luetaan checkpointista.
# VIDEO_SERVER_NUM_INFERENCE_STEPS=50
# VIDEO_SERVER_SHIFT=5.0
# VIDEO_SERVER_GUIDANCE_SCALE=5.0
# VIDEO_SERVER_RESOLUTIONS=["1280x704","704x1280"]

# --- Valinnaiset laajennukset (oletuksena pois) ---------------------------
# Esikatselukuva N askeleen välein. Maksaa yhden ylimääräisen VAE-dekoodauksen
# per kuva; epäonnistuessaan se ei kaada ajoa vaan logittaa varoituksen.
# Kuva näkyy job-vastauksen preview_url-kentässä.
# VIDEO_SERVER_PREVIEW_EVERY_N_STEPS=5
#
# API-avain. Ilman tätä palvelimessa ei ole autentikointia. Jos asetat tämän,
# /api/v1 ja /outputs vaativat X-API-Key-otsakkeen; /api/v1/health jää auki
# monitorointia varten.
# VIDEO_SERVER_API_KEY=vaihda-tama
