# Example configuration. Copy to .env and edit.
# Every setting also works as an environment variable or via config.yaml.
# Precedence: environment variable > .env > config.yaml > built-in default.

# --- Model selection ------------------------------------------------------
# The default is "auto": the server detects VRAM and system memory, derives a
# tier, and uses it to pick both the model and the loading mode. The choice and
# its reasoning are logged at startup, so the same configuration works on
# different hardware without code changes.
# VIDEO_SERVER_BACKEND=auto

# Development without a GPU and without weights. The whole API works and the
# output is a synthetic mp4. This is what the test suite runs against.
# VIDEO_SERVER_BACKEND=mock

# An explicit model overrides the automatic choice:
# VIDEO_SERVER_BACKEND=wan2.2-ti2v-5b     # 5B, T2V + I2V, 720p @ 24 fps
# VIDEO_SERVER_BACKEND=wan2.2-t2v-a14b    # MoE 14B, text -> video only
# VIDEO_SERVER_BACKEND=wan2.2-i2v-a14b    # MoE 14B, requires an init image

# --- What the tiers mean --------------------------------------------------
# low           12-20 GB VRAM      TI2V-5B 4-bit quantised (needs quantized extra)
# mid           20-30 GB VRAM      TI2V-5B bf16            <- an RTX 3090 lands here
# high          30 GB+  VRAM       A14B bf16
# a14b-offload  24 GB + 60 GB RAM  A14B with CPU offload, slow
#
# The tier can be forced, for instance to deliberately run a lighter profile:
# VIDEO_SERVER_TIER=auto

# --- Hardware -------------------------------------------------------------
VIDEO_SERVER_DEVICE=cuda:0
VIDEO_SERVER_DTYPE=bfloat16
# Multi-GPU: choose which card to use (not parallel execution, just selection).
# VIDEO_SERVER_DEVICE=cuda:1

# --- Memory ---------------------------------------------------------------
# Tiled VAE decoding. Decoding is the largest memory spike of a run: without
# this a 24 GB card runs out of memory on 720p video only after denoising has
# already finished.
# VIDEO_SERVER_VAE_TILING=true
#
# Force CPU offload on or off. Left empty, the tier and a VRAM check decide.
# Set to true if the card is shared with other applications.
# VIDEO_SERVER_CPU_OFFLOAD=true

# --- Model weights --------------------------------------------------------
# By default the server does NOT download weights. It reports missing weights
# and the command that fetches them:
#   uv run python scripts/download_model.py wan2.2-ti2v-5b
# Note: TI2V-5B takes ~32 GB of disk and ~23 GB of VRAM while running.
# VIDEO_SERVER_ALLOW_DOWNLOAD=false

# --- Outputs and cleanup --------------------------------------------------
# VIDEO_SERVER_OUTPUTS_DIR=video_server/outputs
# Both rules apply at the same time; an empty value disables that rule.
# VIDEO_SERVER_RETENTION_MAX_AGE_DAYS=14
# VIDEO_SERVER_RETENTION_MAX_TOTAL_GB=20

# --- Queue and requests ---------------------------------------------------
# A full queue responds 429, an oversized body 413.
# VIDEO_SERVER_MAX_QUEUE_SIZE=8
# VIDEO_SERVER_MAX_REQUEST_BYTES=20971520

# --- Overriding profile defaults ------------------------------------------
# Left empty, the model's own values are used, read from the checkpoint.
# VIDEO_SERVER_NUM_INFERENCE_STEPS=50
# VIDEO_SERVER_SHIFT=5.0
# VIDEO_SERVER_GUIDANCE_SCALE=5.0
# VIDEO_SERVER_RESOLUTIONS=["1280x704","704x1280"]

# --- Optional extensions (off by default) ---------------------------------
# A preview image every N steps. Costs one extra VAE decode per image; if it
# fails it does not abort the run, it just logs a warning. The image appears in
# the preview_url field of the job response.
# VIDEO_SERVER_PREVIEW_EVERY_N_STEPS=5
#
# API key. Without this the server has no authentication. If set, /api/v1 and
# /outputs require an X-API-Key header; /api/v1/health stays open for
# monitoring.
# VIDEO_SERVER_API_KEY=change-me
